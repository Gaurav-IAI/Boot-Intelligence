# --- Database -------------------------------------------------------
# Matches docker-compose.yml (host port 5433 to avoid clashing with a local PG).
DATABASE_URL=postgresql+psycopg://poc:poc@localhost:5433/uk_election
ALLOW_SQLITE_FALLBACK=true

# --- HTTP client ----------------------------------------------------
HTTP_CONCURRENCY=3
HTTP_DELAY_SECONDS=0.4
HTTP_TIMEOUT=60
HTTP_RETRIES=4
USER_AGENT=uttarakhand-election-poc/0.1 (research; contact: you@example.org)

# --- OCR (optional; only needed for scanned PDFs such as Form 20 2017/2022) ---
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGES=hin+eng
OCR_DPI=300
